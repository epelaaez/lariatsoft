#include "services_lariat.fcl"
#include "recomcparticlematching.fcl"
 
process_name: PionAbsorptionSelection

services: {
    # Load the service that manages root files for histograms.
    TFileService: { fileName: "PionAbsorptionSelection_histo.root" }
    #@table::standard_resourcetrackers
    RandomNumberGenerator: {} #ART native random number generator
    #message:      @local::lariat_message_services
    @table::lariat_services
}
services.scheduler.SkipEvent: [ ProductNotFound ]

source: {
    module_type: RootInput
    maxEvents: -1
}

# Define and configure some modules to do work on each event.
# First modules are defined; they are scheduled later.
# Modules are grouped by type.
physics: {
    producers: {
        recotrackmcmatching: @local::standard_recomcparticlematching
    }
    
    filters: {
        PionAbsorptionSelection: {
            module_type:              "PionAbsorptionSelection"
	        Verbose:			      false
            WCTrackBuilderLabel:      wctrack
            TPCTrackHandleLabel:      pmtrack
            WC2TPModuleLabel:         wctracktpctrackmatch
            CalorimetryModuleLabel:   calo
            SimulationLabel:          largeant 
            RecoTrackMCMatchLabel:    recotrackmcmatching
            MeanDEDXNumberTrajPoints: 20
            MeanDEDXThreshold:        5.0
            VertexRadius:             4
            SmallTrackLength:         35
            MaxSmallTracks:           5
            MeanCurvatureThreshold:   0.015
            ProtonEnergyLowerBound:   0.075
            ProtonEnergyUpperBound:   1.0
        }
    }
    
    reco: [ recotrackmcmatching, PionAbsorptionSelection ]
    ana: []

    #define the output stream, there could be more than one if using filters 
    stream1:  [ out1 ]
    
    #trigger_paths is a keyword and contains the paths that modify the art::event, 
    #ie filters and producers
    trigger_paths: [ reco ] 
    
    #end_paths is a keyword and contains the paths that do not modify the art::Event, 
    #ie analyzers and output streams.  these all run simultaneously
    end_paths:     [ stream1 ]  
}

#block to define where the output goes.  if you defined a filter in the physics
#block and put it in the trigger_paths then you need to put a SelectEvents: {SelectEvents: [XXX]}
#entry in the output stream you want those to go to, where XXX is the label of the filter module(s)
outputs:
{
    out1: {
        module_type: RootOutput
        SelectEvents: [ reco ]
        fileName:    "Pion_Absorption_Selection.root"
        dataTier:    "reconstructed-2d"
        compressionLevel: 1
    }
}

physics.producers.recotrackmcmatching.match_tracks:  true
physics.producers.recotrackmcmatching.match_showers: false
physics.producers.recotrackmcmatching.cluster_label: "trajcluster"
physics.producers.recotrackmcmatching.track_label:   "pmtrack"
