#include "services_lariat.fcl"
#include "triggeralgo_service.fcl"
#include "imagepatternalgs.fcl"

## Daniel Smith
## dansmith@bu.edu

process_name: NNBeamlineShower

services: {
    TFileService: { fileName: "NNBeamlineShower_hist.root" }
    RandomNumberGenerator: {} #ART native random number generator
    @table::lariat_services
}

source: {
    module_type: RootInput
    maxEvents:  -1        # Number of events to create
}

physics: {
    analyzers: {
        NNBeamlineShower:	{
            module_type: NNBeamlineShower
            ShowerThresh: 0.85
            WireLabel: caldata
            HitModuleLabel: linecluster
            TrackModuleLabel: pmtrack
            WC2TPCModuleLabel: WC2TPCtrk
            WCTrackLabel: wctrack
            NNetModuleLabel: "emtrkmichelid:emtrkmichel:EmTrackId"
            Data: false
            Verbose: false
            SimulationLabel: largeant
            ProtonEnergyLowerBound: 0.075
            ProtonEnergyUpperBound: 1.0
        }
    }

    reco: [ ] 
    ana: [ NNBeamlineShower ] 
    filt:[ ]

    stream1:  [ ]
    trigger_paths: [  reco ] 
    end_paths:     [ ana, stream1 ]  
}

outputs: {
    out1: {
        module_type: RootOutput
        SelectEvents: [ filt ]
        fileName:    "NNBeamlineShower_events.root"
        dataTier:    "reconstructed-2d"
        compressionLevel: 1
    }
}
